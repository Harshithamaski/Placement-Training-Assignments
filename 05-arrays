OUTPUT:3

3.Check If It Is a Good Array
class Solution {

    public boolean isGoodArray(int[] nums) {

        int gcd = nums[0];

        for (int num : nums)
            gcd = gcd(gcd, num);

        return gcd == 1;
    }

    private int gcd(int a, int b) {

        while (b != 0) {
            int temp = a % b;
            a = b;
            b = temp;
        }

        return a;
    }
}
INPUT:nums = [12,5,7,23]
OUTPUT:true
