1.Input a year and find whether it is a leap year or not.
START
INPUT year

IF (year % 400 == 0) OR (year % 4 == 0 AND year % 100 != 0) THEN
    PRINT "Leap Year"
ELSE
    PRINT "Not a Leap Year"
END IF

STOP

